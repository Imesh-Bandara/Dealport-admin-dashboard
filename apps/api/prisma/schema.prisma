generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
}

enum NotificationType {
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[] @relation("ProductTags")
}

model Product {
  id              String        @id @default(uuid())
  name            String
  description     String?
  price           Decimal       @db.Decimal(10, 2)
  discountPrice   Decimal?      @db.Decimal(10, 2)
  expirationStart DateTime?
  expirationEnd   DateTime?
  taxIncluded     Boolean       @default(true)
  stockQuantity   Int           @default(0)
  stockUnlimited  Boolean       @default(false)
  stockStatus     StockStatus   @default(IN_STOCK)
  status          ProductStatus @default(DRAFT)
  featured        Boolean       @default(false)
  imageUrl        String?
  images          String[]      @default([])
  colors          String[]      @default([])
  totalOrders     Int           @default(0)
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id])
  tags            Tag[]         @relation("ProductTags")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([name])
  @@index([status])
  @@index([categoryId])
}

// No FK to Product on purpose: a "product deleted" notification must
// survive after the product it refers to is gone, so the message is a
// pre-formatted, self-contained string rather than a live reference.
model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([read])
  @@index([createdAt])
}
